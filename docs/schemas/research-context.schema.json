{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guide-flow/research-context.schema.json",
  "title": "ResearchContext",
  "type": "object",
  "additionalProperties": false,
  "required": ["query", "sources", "retrievedAt", "status"],
  "properties": {
    "query": {"type": "string"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "retrievedAt": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["used", "not_needed", "research_unavailable", "conflict", "rejected", "found", "verified", "searching"]},
    "matchedQuestion": {"$ref": "#/$defs/matchedQuestion"},
    "referenceSolution": {"$ref": "#/$defs/referenceSolution"},
    "durationMs": {"type": "integer", "minimum": 0},
    "errorCode": {"type": "string"}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "summary", "trustScore"],
      "properties": {
        "title": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "summary": {"type": "string"},
        "trustScore": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "matchedQuestion": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "matchScore", "matchedSubquestionCount", "checks"],
      "properties": {
        "title": {"type": "string"}, "matchScore": {"type": "number", "minimum": 0, "maximum": 1},
        "matchedSubquestionCount": {"type": "integer", "minimum": 0}, "checks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "referenceSolution": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "steps", "finalAnswer", "uncertainties"],
      "properties": {
        "status": {"type": "string", "enum": ["candidate", "verified", "rejected"]},
        "steps": {"type": "array", "items": {"type": "string"}}, "finalAnswer": {"type": "string"},
        "uncertainties": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
