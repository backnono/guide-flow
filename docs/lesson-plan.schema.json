{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["title", "steps", "finalAnswer", "practice"],
  "properties": {
    "title": {"type": "string"},
    "steps": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/step"}},
    "finalAnswer": {"type": "string", "minLength": 1},
    "commonMistakes": {"type": "array", "items": {"type": "string"}},
    "practice": {"type": "object", "required": ["question", "answer"], "properties": {"question": {"type": "string"}, "answer": {"type": "string"}, "checkExpression": {"type": "string"}}, "additionalProperties": false}
  },
  "additionalProperties": false,
  "$defs": {
    "step": {
      "type": "object",
      "required": ["title", "explanation", "formula", "visual", "voiceText"],
      "properties": {
        "title": {"type": "string"}, "explanation": {"type": "string"}, "formula": {"type": "string"}, "voiceText": {"type": "string"},
        "visual": {"type": "object", "required": ["type"], "properties": {"type": {"enum": ["ratio_bar", "groups", "number_line", "formula_reveal"]}, "segments": {"type": "array", "items": {"type": "integer", "minimum": 1}}}, "additionalProperties": false}
      },
      "additionalProperties": false
    }
  }
}
